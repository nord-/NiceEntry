<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:drawing="clr-namespace:NiceEntry.Drawing"
      x:Class="NiceEntry.LabelBase"
      Padding="0,7,0,0"
      RowDefinitions="Auto,Auto,Auto">
    <!-- Nycklarna kommer från konsumentappens MAUI-mall-resurser -->
    <!-- ReSharper disable Xaml.StaticResourceNotResolved -->
<Grid.Resources>
    <ResourceDictionary>
        <Style x:Key="BaseLabel" TargetType="Label">
            <Setter Property="Padding" Value="4, 0" />
            <Setter Property="Margin" Value="12, 0, 0, 0" />
            <Setter Property="FontSize">
                <Setter.Value>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="Android" Value="12" />
                        <On Platform="iOS" Value="11" />
                    </OnPlatform>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Start" />
        </Style>

        <Style x:Key="BaseLabelLabel" BasedOn="{StaticResource BaseLabel}" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
            <Setter Property="Margin" Value="3,0,4,0" />
        </Style>
    
        <Style x:Key="BaseRequiredLabelLabel" BasedOn="{StaticResource BaseLabelLabel}" TargetType="Label">
            <Setter Property="TextColor" Value="Red" />
            <Setter Property="Margin" Value="4,1,-3,0" />
            <Setter Property="Padding" Value="4,0,0,0" />
        </Style>

        <Style x:Key="LabelContainer" TargetType="Grid">
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Margin">
                <Setter.Value>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="14,-7,8,0" />
                        <On Platform="iOS" Value="14,-10,8,0" />
                    </OnPlatform>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExampleLabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="10,2,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#9E9E9E, Dark=#BDBDBD}" />
        </Style>

        <Style x:Key="ErrorLabel" TargetType="Label" BasedOn="{StaticResource BaseRequiredLabelLabel}">
            <Setter Property="Margin" Value="10,2,0,0" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
    </ResourceDictionary>
</Grid.Resources>

    <drawing:NotchedBorder x:Name="BorderLabel"
                           Grid.Row="0"
                           CornerRadius="8"
                           StrokeThickness="1" />
    <Grid x:Name="LabelContainer" Style="{StaticResource LabelContainer}"
          ColumnDefinitions="Auto,*">
        <Label x:Name="RequiredLabel" Grid.Column="0" Text="*" Style="{StaticResource BaseRequiredLabelLabel}" />
        <Label x:Name="LabelLabel" Grid.Column="1" Style="{StaticResource BaseLabelLabel}" LineBreakMode="TailTruncation" />
    </Grid>
    <Label x:Name="ExampleLabel" Grid.Row="1"
           IsVisible="False"
           Style="{StaticResource ExampleLabelStyle}" />
    <Label x:Name="ErrorLabel" Grid.Row="2"
           IsVisible="False"
           Style="{StaticResource ErrorLabel}" />
</Grid>