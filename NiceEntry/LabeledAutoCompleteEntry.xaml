<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ne="clr-namespace:NiceEntry"
             x:Class="NiceEntry.LabeledAutoCompleteEntry">
    <VerticalStackLayout Spacing="2">
        <ne:LabeledEntry x:Name="Entry" />
        <Border x:Name="DropdownBorder"
                IsVisible="False"
                StrokeShape="RoundRectangle 4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#212121, Dark=#E1E1E1}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
            <CollectionView x:Name="SuggestionsView"
                            MaximumHeightRequest="240"
                            SelectionMode="Single"
                            SelectionChanged="OnSuggestionTapped" />
        </Border>
    </VerticalStackLayout>
</ContentView>
