root = true

# All files
[*]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

# C# files
[*.cs]
indent_size = 4

# XML project / config files
[*.{csproj,props,targets,config,nuspec}]
indent_size = 2

# XAML files
[*.xaml]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
