<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ne="clr-namespace:NiceEntry;assembly=NiceEntry"
             xmlns:demo="clr-namespace:NiceEntryDemoApp"
             x:Class="NiceEntryDemoApp.MainPage" x:DataType="demo:MainViewModel">

    <ScrollView>
    <VerticalStackLayout Margin="16,32" Spacing="25" Padding="0,0,0,400">
        <Border BackgroundColor="DarkSlateBlue" Padding="16" StrokeThickness="0">
            <ne:LabeledEntry Label="On a colored surface"
                             Placeholder="Notch should be cut, no rectangle behind label" />
        </Border>

        <!-- NICEBUTTON-DEV-CHECKS (temporary; removed atomically in Task 9) -->
        <ne:NiceButton Text="Buy now" Icon="Cart" Orientation="Horizontal" IconPlacement="Start" />
        <ne:NiceButton Icon="ThumbUp" ButtonShape="Circle" />
        <ne:NiceButton Text="Rounded" ButtonShape="Rounded" CornerRadius="20" />
        <ne:NiceButton Text="Rectangle" ButtonShape="Rectangle" />
        <ne:NiceButton Text="Default theme colors" Icon="Check" />
        <ne:NiceButton Text="Custom" Icon="Star" BackgroundColor="DarkGreen" TextColor="White" />
        <ne:NiceButton Text="Disabled" Icon="Lock" IsEnabled="False" />
        <!-- /NICEBUTTON-DEV-CHECKS -->

        <ne:LabeledEntry Label="First name or Last name"
                         IsRequired="True"
                         Placeholder="John Doe"
                         Text="{Binding MyProperty}"
                         Keyboard="Numeric"
                         Example="e.g. John Doe"
                         Error="{Binding ValidationErrors[MyProperty]}"
                         ReturnCommand="{Binding EnterPressedCommand}" />

        <ne:LabeledEntry Label="Battery size"
                         Keyboard="Numeric"
                         HorizontalTextAlignment="End"
                         Unit="kWh"
                         Example="e.g. 70 kWh" />

        <ne:LabeledEntry Label="Unit: custom font &amp; color"
                         Keyboard="Numeric"
                         HorizontalTextAlignment="End"
                         Unit="kg"
                         UnitFontSize="20"
                         UnitFontFamily="OpenSansSemibold"
                         UnitColor="DarkOrange"
                         Example="Unit with FontSize=20, FontFamily=OpenSansSemibold, Color=DarkOrange" />

        <ne:LabeledEntry Label="Extra padding"
                         Placeholder="Type here..."
                         ContentPadding="24,20"
                         Example="ContentPadding=24,20 (default is 12,10)" />

        <ne:LabeledEntry Label="Minimal padding"
                         Placeholder="Type here..."
                         ContentPadding="4,2"
                         Unit="m"
                         Example="ContentPadding=4,2 — tighter layout" />

        <ne:LabeledEntry Label="A really, really long heading that makes the label stretch much more than there's space for."
                         Placeholder="Type here..." />

        <ne:LabeledDatePicker Label="Select a date"
                              Date="{Binding DateSelected}"
                              MinimumDate="2025-05-01"
                              Example="Test"
                              Error="{Binding ValidationErrors[DateSelected]}" />

        <ne:LabeledTimePicker Label="Select a time"
                              Time="{Binding TimeSelected}"
                              IsRequired="True"
                              Error="{Binding ValidationErrors[TimeSelected]}" 
                              />

        <ne:LabeledPicker Label="Select from list"
                          Placeholder="Select one"
                          IsRequired="True"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding PickedItem}"
                          ItemDisplayBinding="{Binding PickerValue, x:DataType=demo:PickerItem}"
                          Error="{Binding ValidationErrors[PickedItem]}"
                          />

        <ne:LabeledAutoCompleteEntry Label="ICAO-code"
                                     Placeholder="e.g. ESGG"
                                     CommitOnUpperCase="True"
                                     MaxSuggestions="6"
                                     Text="{Binding IcaoText}"
                                     Suggestions="{Binding IcaoSuggestions}" />
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
